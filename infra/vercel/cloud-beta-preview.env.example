# Vercel Preview environment template. Do not commit real values.

# ResourceSpace staging
RESOURCESPACE_BASE_URL=https://dam-staging.tjc.org
RESOURCESPACE_API_USER=portal-beta-api
RESOURCESPACE_API_KEY=
RESOURCESPACE_FIELD_MAP_JSON=
RESOURCESPACE_DEFAULT_COLLECTION_ID=
RESOURCESPACE_API_PAGE_SIZE=500
RESOURCESPACE_API_MAX_PAGES=10000
RESOURCESPACE_ENABLE_WRITEBACK=0
RESOURCESPACE_WRITEBACK_MODE=queued

# Beta auth
BETA_AUTH_ENABLED=true
BETA_SESSION_SECRET=
BETA_VIEWER_PASSWORD=
BETA_CONTRIBUTOR_PASSWORD=
BETA_REVIEWER_PASSWORD=
BETA_ADMIN_PASSWORD=
BETA_CHURCH_INVITE_CODES_JSON=
PORTAL_ALLOW_BETA_ROLE_OVERRIDE=0
NEXT_PUBLIC_LOCAL_BETA_ROLE_SWITCH=0

# Feedback storage: implemented path uses Vercel KV, optional Blob attachments.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BETA_FEEDBACK_ENABLED=1
BETA_FEEDBACK_ATTACHMENTS_ENABLED=0
BLOB_READ_WRITE_TOKEN=

# Runtime stores not production-ready until durable adapters exist.
RUNTIME_STORE=local-filesystem
PENDING_WRITES_STORE=local-filesystem
UPLOAD_INTAKE_STORE=local-filesystem

# Download/original safety
DOWNLOAD_GATE_ALLOW_DEMO_ROLES=0
SOURCE_ORIGINAL_DOWNLOADS_ENABLED=0
